# Use Razorpay TEST keys for local development. Keep the secret private.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# This key ID is public and is bundled into the browser by Vite.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id

# Private Vercel Blob read-write token. Never expose this to the browser or commit it.
BLOB_READ_WRITE_TOKEN=replace_with_private_blob_store_token
